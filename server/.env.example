# MongoDB connection string. Leave empty to use an in-memory database
# (auto-seeded with demo products) for local development.
MONGO_URI=

# Port for the API in development (the Vite dev server proxies /api here).
API_PORT=5000
# Port in production (usually injected by the hosting platform).
PORT=5000

# Comma-separated list of allowed origins for CORS in development.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
